---
export interface Props {
  items: {
    title: string;
    subtitle: string;
    period: string;
    description: string;
  }[];
}

const { items } = Astro.props;
---

<div class="space-y-8">
  {items.map((item) => (
    <div class="relative pl-8 md:pl-10">
      <div class="absolute left-0 top-2 h-3 w-3 rounded-full" style="background-color: var(--color-accent);"></div>
      <div class="absolute left-[5px] top-5 h-full w-px" style="background-color: var(--color-border);"></div>

      <div class="flex flex-col justify-between gap-1 md:flex-row md:items-center">
        <h3 class="text-lg font-semibold" style="color: var(--color-fg);">{item.title}</h3>
        <span class="text-sm" style="color: var(--color-muted);">{item.period}</span>
      </div>
      <p class="text-sm font-medium" style="color: var(--color-accent);">{item.subtitle}</p>
      <p class="mt-2" style="color: var(--color-muted);">{item.description}</p>
    </div>
  ))}
</div>
