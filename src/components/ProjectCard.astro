---
import type { Project } from '../data/projects';
import { caseStudies } from '../data/case-studies';
import { withBase } from '../lib/urls';
export interface Props { project: Project; }
const { project: p } = Astro.props;
const study = caseStudies[p.slug];
---
<article class="project-entry" data-category={p.category}>
  <header class="project-entry-heading">
    <h3><a href={withBase(`projects/${p.slug}/`)}>{p.name}</a></h3>
    <p class="project-role">{study?.role || p.subtitle}</p>
  </header>
  <p class="project-description">{study?.summary || p.description}</p>
  {study ? <ul class="project-contributions">{study.contributions.map(item => <li>{item}</li>)}</ul>
    : p.highlights && <ul class="project-contributions">{p.highlights.map(item => <li>{item}</li>)}</ul>}
  {study && <p class="project-progress"><span>当前进展：</span>{study.result}</p>}
  <div class="project-links">
    <a href={withBase(`projects/${p.slug}/`)} aria-label={`了解 ${p.name} 的设计与实现`}>项目详情</a>
    {p.link && <a href={p.link} target="_blank" rel="noopener noreferrer">{p.sourceLabel}</a>}
  </div>
</article>
