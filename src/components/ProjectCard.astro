---
export interface Props {
  name: string;
  description: string;
  tech: string[];
  link?: string;
  demo?: string;
}

const { name, description, tech, link, demo } = Astro.props;
---

<article
  class="group flex flex-col rounded-2xl border p-6 transition-all hover:-translate-y-1 hover:shadow-lg"
  style="background-color: var(--color-bg); border-color: var(--color-border);"
>
  <div class="flex items-start justify-between gap-4">
    <h3 class="text-xl font-semibold" style="color: var(--color-fg);">{name}</h3>
    <div class="flex items-center gap-3">
      {demo && (
        <a href={demo} target="_blank" rel="noopener noreferrer" class="text-sm font-medium transition-colors hover:text-[var(--color-accent)]" style="color: var(--color-muted);">
          Demo
        </a>
      )}
      {link && (
        <a href={link} target="_blank" rel="noopener noreferrer" class="text-sm font-medium transition-colors hover:text-[var(--color-accent)]" style="color: var(--color-muted);">
          Code
        </a>
      )}
    </div>
  </div>

  <p class="mt-3 flex-1" style="color: var(--color-muted);">{description}</p>

  <div class="mt-5 flex flex-wrap gap-2">
    {tech.map((t) => (
      <span
        class="rounded-full px-3 py-1 text-xs font-medium"
        style="background-color: var(--color-surface); color: var(--color-muted);"
      >
        {t}
      </span>
    ))}
  </div>
</article>
