---
export interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<section class="py-16 md:py-24">
  <div class="mx-auto max-w-5xl px-6">
    <h2 class="text-3xl font-bold tracking-tight md:text-4xl" style="color: var(--color-fg);">
      {title}
    </h2>
    {subtitle && (
      <p class="mt-4 text-lg" style="color: var(--color-muted);">{subtitle}</p>
    )}
    <div class="mt-10">
      <slot />
    </div>
  </div>
</section>
