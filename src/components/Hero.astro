---
import { resume } from '../data/resume';
---

<section class="relative overflow-hidden py-20 md:py-32">
  <div class="mx-auto max-w-5xl px-6">
    <div class="flex flex-col-reverse items-start gap-12 md:flex-row md:items-center">
      <div class="flex-1">
        <p class="text-sm font-semibold uppercase tracking-widest" style="color: var(--color-accent);">
          {resume.title}
        </p>
        <h1 class="mt-4 text-4xl font-bold tracking-tight md:text-6xl" style="color: var(--color-fg);">
          {resume.name}
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed" style="color: var(--color-muted);">
          {resume.tagline}
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a
            href="/about"
            class="rounded-full px-6 py-3 text-sm font-medium text-white transition-colors"
            style="background-color: var(--color-accent);"
            onmouseover="this.style.backgroundColor='var(--color-accent-hover)'"
            onmouseout="this.style.backgroundColor='var(--color-accent)'"
          >
            了解更多
          </a>
          <a
            href={resume.github}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-full border px-6 py-3 text-sm font-medium transition-colors hover:bg-[var(--color-surface)]"
            style="border-color: var(--color-border); color: var(--color-fg);"
          >
            GitHub
          </a>
        </div>
      </div>

      <div class="shrink-0">
        <div
          class="flex h-36 w-36 items-center justify-center rounded-full border-2 text-5xl font-bold md:h-48 md:w-48 md:text-6xl"
          style="background-color: var(--color-surface); border-color: var(--color-border); color: var(--color-accent);"
        >
          {resume.name.slice(0, 1)}
        </div>
      </div>
    </div>
  </div>
</section>
