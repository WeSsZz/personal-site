---
import { resume } from '../data/resume';
import { withBase } from '../lib/urls';
---
<section class="profile-intro container" aria-labelledby="profile-name">
  <h1 id="profile-name">{resume.name}</h1>
  <p class="profile-direction">{resume.title}</p>
  <div class="profile-bio">{resume.introduction.map(paragraph => <p>{paragraph}</p>)}</div>
  <p class="profile-opportunity">目前正在寻找 LLM Agent 算法 / 工程方向的实习机会。</p>
  <div class="profile-links">
    <a href={`mailto:${resume.email}`}>邮箱</a>
    <a href={resume.github} target="_blank" rel="noopener noreferrer">GitHub</a>
    <a href={withBase('about/')}>更多经历</a>
    <span>{resume.location}</span>
  </div>
</section>
