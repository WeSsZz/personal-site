---
import { resume } from '../data/resume';
import { withBase } from '../lib/urls';
const nav = [
  { label: '首页', path: '' },
  { label: '项目', path: 'projects/' },
  { label: '文章', path: 'blog/' },
  { label: '关于', path: 'about/' },
];
const active = (path: string) => path
  ? Astro.url.pathname.startsWith(withBase(path))
  : Astro.url.pathname === withBase('');
---
<header class="site-header">
  <div class="container header-inner">
    <a class="site-name" href={withBase('')} aria-label={`${resume.name}，返回首页`}>{resume.siteName}</a>
    <nav class="site-nav" aria-label="主要导航">
      {nav.map(item => <a href={withBase(item.path)} aria-current={active(item.path) ? 'page' : undefined}>{item.label}</a>)}
    </nav>
    <button class="theme-toggle" id="theme-toggle" type="button" aria-label="切换为深色主题" aria-pressed="false"><span class="theme-label">深色</span></button>
  </div>
</header>
<script>
const toggle = document.querySelector<HTMLButtonElement>('#theme-toggle');
function syncTheme() {
  const dark = document.documentElement.classList.contains('dark');
  toggle?.setAttribute('aria-pressed', String(dark));
  toggle?.setAttribute('aria-label', dark ? '切换为浅色主题' : '切换为深色主题');
  const label = toggle?.querySelector('.theme-label');
  if (label) label.textContent = dark ? '浅色' : '深色';
}
syncTheme();
toggle?.addEventListener('click', () => {
  document.documentElement.classList.toggle('dark');
  try { localStorage.setItem('theme', document.documentElement.classList.contains('dark') ? 'dark' : 'light'); } catch {}
  syncTheme();
});
</script>
