---
import { withBase } from '../lib/urls';
const nav = [{ label: '首页', path: '' }, { label: '项目', path: 'projects/' }, { label: '关于', path: 'about/' }, { label: '文章', path: 'blog/' }];
const active = (path: string) => path ? Astro.url.pathname.startsWith(withBase(path)) : Astro.url.pathname === withBase('');
---
<header class="site-header"><div class="container header-inner">
<a class="wordmark" href={withBase('')} aria-label="周骏炜，返回首页"><span class="monogram">JW<span>.</span></span><span class="wordmark-name">周骏炜<small>ENGINEERING NOTES & WORK</small></span></a>
<nav class="desktop-nav" aria-label="主要导航">{nav.map(n => <a href={withBase(n.path)} aria-current={active(n.path) ? 'page' : undefined}>{n.label}</a>)}</nav>
<div class="header-tools"><button class="icon-button" id="theme-toggle" type="button" aria-label="切换为深色主题" aria-pressed="false"><svg class="theme-moon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M20 15a8 8 0 0 1-11-11 8 8 0 1 0 11 11Z"/></svg><svg class="theme-sun" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.4 1.4m11.2 11.2L19 19M5 19l1.4-1.4M17.6 6.4 19 5"/></svg></button>
<button class="icon-button mobile-toggle" id="mobile-toggle" type="button" aria-label="打开导航" aria-expanded="false" aria-controls="mobile-nav"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button></div></div>
<nav class="container mobile-nav" id="mobile-nav" aria-label="移动端导航" hidden>{nav.map(n => <a href={withBase(n.path)} aria-current={active(n.path) ? 'page' : undefined}>{n.label}</a>)}</nav></header>
<script>
const theme = document.querySelector<HTMLButtonElement>('#theme-toggle');
function syncTheme() { const dark = document.documentElement.classList.contains('dark'); theme?.setAttribute('aria-pressed', String(dark)); theme?.setAttribute('aria-label', dark ? '切换为浅色主题' : '切换为深色主题'); }
syncTheme(); theme?.addEventListener('click', () => { document.documentElement.classList.toggle('dark'); try { localStorage.setItem('theme', document.documentElement.classList.contains('dark') ? 'dark' : 'light'); } catch {} syncTheme(); });
const toggle = document.querySelector<HTMLButtonElement>('#mobile-toggle'); const menu = document.querySelector<HTMLElement>('#mobile-nav');
function closeMenu() { if(menu)menu.hidden=true; toggle?.setAttribute('aria-expanded','false'); toggle?.setAttribute('aria-label','打开导航'); }
toggle?.addEventListener('click', () => { const open=toggle.getAttribute('aria-expanded')!=='true'; if(menu)menu.hidden=!open; toggle.setAttribute('aria-expanded',String(open)); toggle.setAttribute('aria-label',open?'关闭导航':'打开导航'); });
document.addEventListener('keydown',e=>{if(e.key==='Escape' && toggle?.getAttribute('aria-expanded')==='true'){closeMenu();toggle.focus();}});
matchMedia('(min-width: 760px)').addEventListener('change',e=>{if(e.matches)closeMenu();});
</script>
