---
import Layout from '../layouts/Layout.astro';import {resume} from '../data/resume';
const skills=[['语言',resume.skills.languages],['后端',resume.skills.backend],['AI 与 Agent',resume.skills.ai],['工程工具',resume.skills.tools]];
---
<Layout title="关于我" description="周骏炜的教育背景、金融科技实习经历与工程方向。"><section class="section container"><div class="about-intro"><div class="page-heading"><p class="eyebrow">ABOUT / JUNWEI ZHOU</p><h1>在工程与 AI 之间，<br/>持续探索<span class="accent">。</span></h1><p class="bio">{resume.about}</p></div><aside class="contact-card"><h2>保持联系</h2><p>{resume.location}</p><a href={`mailto:${resume.email}`}>{resume.email} ↗</a><a href={resume.github} target="_blank" rel="noopener noreferrer">GitHub / WeSsZz ↗</a><button class="button print-button" id="print-resume" type="button">打印经历页 ↓</button></aside></div>
<section class="resume-block"><h2>教育背景</h2><div>{resume.education.map(e=><div class="timeline-item"><div class="timeline-head"><h3>{e.school}</h3><time>{e.period}</time></div><p class="timeline-subtitle">{e.degree}</p><p class="timeline-description">{e.description}</p></div>)}</div></section>
<section class="resume-block"><h2>实习经历</h2><div>{resume.experience.map(e=><div class="timeline-item"><div class="timeline-head"><h3>{e.company}</h3><time>{e.period}</time></div><p class="timeline-subtitle">{e.role}</p><p class="timeline-description">{e.description}</p></div>)}</div></section>
<section class="resume-block"><h2>技术方向</h2><div class="skills-grid">{skills.map(([name,tags])=><div><h3>{name}</h3><div class="tags">{(tags as string[]).map(t=><span>{t}</span>)}</div></div>)}</div></section>
<section class="resume-block"><h2>其他实践</h2><div>{resume.projects.map(p=><div class="timeline-item"><h3>{p.name}</h3><p class="timeline-description" style="margin-top:12px">{p.description}</p><div class="tags">{p.tech.map(t=><span>{t}</span>)}</div></div>)}</div></section>
<section class="resume-block"><h2>论文与获奖</h2><div>{resume.publications.map(p=><div class="timeline-item"><h3 class="publication-title">{p.title}</h3><p class="publication-meta">{p.venue}</p><p class="publication-meta">ISBN {p.isbn}</p></div>)}{resume.awards.map(a=><div class="timeline-item"><div class="timeline-head"><h3>{a.title}</h3><time>{a.date}</time></div></div>)}</div></section></section></Layout>
<script>document.querySelector('#print-resume')?.addEventListener('click',()=>window.print());</script>
