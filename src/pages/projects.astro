---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects, featuredProjects } from '../data/projects';
import { withBase } from '../lib/urls';
const supportingProjects = projects.filter(project => !project.featured);
---
<Layout title="项目" description="购物 Agent 后训练与 Enterprise Agent：项目背景、个人实现、实验记录与技术笔记。">
  <section class="section container">
    <header class="page-heading"><h1>项目</h1><p>这里记录我在 Agent 后训练和执行框架上的工作。每个项目都注明已有基础、我的实现，以及目前能够支持的结论。</p></header>
    <div class="project-list project-index">{featuredProjects.map(project => <ProjectCard project={project}/>)}</div>
    <aside class="supporting-work"><h2>实习中的工程实践</h2><p>此外，我在后端实习中参与过文件传输、任务管理与审批链路的开发。</p>{supportingProjects.map(project => <a href={withBase(`projects/${project.slug}/`)}>{project.name}</a>)}</aside>
  </section>
</Layout>
