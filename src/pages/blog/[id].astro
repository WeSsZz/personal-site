---
import Layout from '../../layouts/Layout.astro';import {getCollection,render} from 'astro:content';import {withBase} from '../../lib/urls';
export async function getStaticPaths(){return (await getCollection('blog')).filter(p=>!p.data.draft).map(post=>({params:{id:post.id},props:{post}}));}
const {post}=Astro.props;const {Content}=await render(post);const {title,description,pubDate,updatedDate,tags}=post.data;
const minutes=Math.max(1,Math.ceil((post.body??'').replace(/\s/g,'').length/450));
---
<Layout title={title} description={description} type="article"><article class="section container article"><a class="text-link article-back" href={withBase('blog/')}>← 返回文章列表</a><header class="article-header"><div class="post-meta"><time datetime={pubDate.toISOString()}>{pubDate.toLocaleDateString('zh-CN',{timeZone:'UTC',year:'numeric',month:'long',day:'numeric'})}</time><span>约 {minutes} 分钟阅读</span>{updatedDate&&<span>更新于 {updatedDate.toLocaleDateString('zh-CN',{timeZone:'UTC'})}</span>}</div><h1>{title}</h1><p>{description}</p><div class="tags">{tags.map((tag:string)=><span>{tag}</span>)}</div></header><div class="prose"><Content/></div><footer class="article-footer"><a class="text-link" href={withBase('blog/')}>继续阅读其他文章 →</a></footer></article></Layout>
