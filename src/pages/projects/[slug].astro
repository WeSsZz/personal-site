---
import Layout from '../../layouts/Layout.astro';import { projects } from '../../data/projects';import { withBase } from '../../lib/urls';
export function getStaticPaths(){return projects.map(project=>({params:{slug:project.slug},props:{project}}));}const {project:p}=Astro.props;
---
<Layout title={p.name} description={p.description}>
  <article class="section container project-detail">
    <a class="text-link" href={withBase('projects/')}>← 返回项目列表</a>
    <header class="detail-header">
      <div class="eyebrow">PROJECT / {p.number} <span>{p.category}</span></div>
      <h1>{p.name}</h1>
      <p class="detail-subtitle">{p.subtitle}</p>
      <p class="detail-intro">{p.description}</p>
      <div class="tags">{p.tech.map(t => <span>{t}</span>)}</div>
      {p.link && <a class="button primary" href={p.link} target="_blank" rel="noopener noreferrer">查看{p.sourceLabel} ↗</a>}
    </header>
    <div class="project-flow" aria-label="项目关键流程">
      {p.flow.map((item, i) => <div><span class="mono">0{i + 1}</span><strong>{item}</strong>{i < p.flow.length - 1 && <span class="flow-arrow" aria-hidden="true">→</span>}</div>)}
    </div>
    <div class="detail-section"><h2>要解决的问题</h2><p>{p.challenge}</p></div>
    <div class="detail-section">
      <h2>设计与实现</h2>
      <div class="decision-list">{p.decisions.map(([title, text], i) => <div><span class="mono">0{i + 1}</span><h3>{title}</h3><p>{text}</p></div>)}</div>
    </div>
    <div class="detail-section result-section">
      <div><p class="eyebrow">CURRENT STATE</p><h2>{p.status}</h2></div><p>{p.outcome}</p>
    </div>
    {p.comparison && <section class="detail-section experiment-results" aria-labelledby="comparison-heading">
      <h2 id="comparison-heading">实验对照</h2>
      <table class="comparison-table">
        <caption>{p.comparison.caption}</caption>
        <thead><tr><th scope="col">模型 / 检查点</th><th scope="col">严格购买成功</th></tr></thead>
        <tbody>{p.comparison.rows.map(row => <tr><th scope="row">{row.name}</th><td>{row.success}</td></tr>)}</tbody>
      </table>
      <p class="experiment-note">{p.comparison.note}</p>
    </section>}
    <footer class="detail-footer">
      <a class="text-link" href={withBase('projects/')}>继续探索其他项目 →</a>
      {p.link && <a class="source-link" href={p.link} target="_blank" rel="noopener noreferrer">{p.sourceLabel} ↗</a>}
    </footer>
  </article>
</Layout>
