---
import Layout from '../../layouts/Layout.astro';
import { projects } from '../../data/projects';
import { caseStudies } from '../../data/case-studies';
import CaseArchitecture from '../../components/CaseArchitecture.astro';
import CaseTimeline from '../../components/CaseTimeline.astro';
import { withBase } from '../../lib/urls';
export function getStaticPaths() {
  return projects.map(project => ({params:{slug:project.slug},props:{project}}));
}
const { project: p } = Astro.props;
const study = caseStudies[p.slug];
---
<Layout title={p.name} description={study?.summary || p.description}>
  <article class="section container project-detail">
    <a class="back-link" href={withBase('projects/')}>返回项目列表</a>
    <header class="detail-header">
      <h1>{p.name}</h1>
      <p class="detail-subtitle">{study?.role || p.subtitle}</p>
      <p class="detail-intro">{study?.summary || p.description}</p>
      {study && <p class="detail-progress"><strong>当前进展：</strong>{study.result}</p>}
      <nav class="case-resource-links" aria-label="项目资料">
        {study && <><a href="#architecture">系统结构</a><a href={withBase(study.report.path)} target="_blank" rel="noopener noreferrer">{study.report.label}</a></>}
        {p.link && <a href={p.link} target="_blank" rel="noopener noreferrer">{p.sourceLabel}</a>}
      </nav>
    </header>
    {study && <>
      <section class="detail-section" aria-labelledby="scope-heading">
        <h2 id="scope-heading">项目基础与我的工作</h2>
        <div class="scope-table-wrap"><table class="scope-table"><thead><tr><th scope="col">部分</th><th scope="col">沿用的基础</th><th scope="col">我的工作</th></tr></thead><tbody>{study.scope.map(row => <tr><th scope="row">{row.area}</th><td>{row.baseline}</td><td>{row.change}</td></tr>)}</tbody></table></div>
      </section>
      <section class="detail-section" id="architecture" aria-labelledby="architecture-heading"><h2 id="architecture-heading">系统结构</h2><CaseArchitecture study={study}/></section>
      <section class="detail-section" aria-labelledby="timeline-heading"><h2 id="timeline-heading">{study.timeline.title}</h2><CaseTimeline study={study}/></section>
    </>}
    {p.evidence && <section class="detail-section" aria-labelledby="evidence-heading"><h2 id="evidence-heading">验证记录</h2><dl class="evidence-list">{p.evidence.map(item => <div><dt>{item.label}</dt><dd><strong>{item.value}</strong><p>{item.note}</p></dd></div>)}</dl></section>}
    {p.comparisons?.map((comparison,index) => <section class="detail-section experiment-results" aria-labelledby={`comparison-${index}`}><h2 id={`comparison-${index}`}>{comparison.title}</h2><div class="comparison-wrap"><table class="comparison-table"><caption>{comparison.caption}</caption><thead><tr>{comparison.columns.map(column => <th scope="col">{column}</th>)}</tr></thead><tbody>{comparison.rows.map(row => <tr><th scope="row">{row.name}</th><td>{row.success}</td></tr>)}</tbody></table></div><p class="experiment-note">{comparison.note}</p></section>)}
    <section class="detail-section"><h2>进展与后续工作</h2><p>{p.outcome}</p></section>
    <section class="detail-section">
      <h2>实现与取舍</h2>
      {study ? <div class="implementation-details"><details><summary>项目要解决的问题</summary><p>{p.challenge}</p></details>{p.decisions.map(([title,text]) => <details><summary>{title}</summary><p>{text}</p></details>)}</div> : <><p>{p.challenge}</p><div class="decision-list">{p.decisions.map(([title,text]) => <section><h3>{title}</h3><p>{text}</p></section>)}</div></>}
    </section>
    {study && <aside class="case-reading"><h2>相关笔记</h2><a href={withBase(`blog/${study.article.slug}/`)}>{study.article.label}</a></aside>}
    <footer class="detail-footer"><a href={withBase('projects/')}>返回项目列表</a></footer>
  </article>
</Layout>
