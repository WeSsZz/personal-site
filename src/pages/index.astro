---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostCard from '../components/PostCard.astro';
import { featuredProjects } from '../data/projects';
import { withBase } from '../lib/urls';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog')).filter(post => !post.data.draft)
  .sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0,2);
---
<Layout>
  <Hero/>
  <section class="home-section container" aria-labelledby="projects-heading">
    <div class="section-heading"><h2 id="projects-heading">项目</h2><a href={withBase('projects/')}>全部项目</a></div>
    <div class="project-list">{featuredProjects.map(project => <ProjectCard project={project}/>)}</div>
  </section>
  <section class="home-section writing-section container" aria-labelledby="writing-heading">
    <div class="section-heading"><h2 id="writing-heading">最近的笔记</h2><a href={withBase('blog/')}>全部文章</a></div>
    <div class="post-list">{posts.map(post => <PostCard post={post}/>)}</div>
  </section>
</Layout>
